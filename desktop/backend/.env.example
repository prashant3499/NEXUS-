# NEXUS environment. Copy to .env and fill for your target.
# Pilot/dev runs with all defaults (mock payments, file store, no auth).

NODE_ENV=development
PORT=4100

# ── Persistence ── file (pilot) | postgres (scale)
STORE_DRIVER=file
# DATABASE_URL=postgres://user:pass@host:5432/nexus
DATA_DIR=./data

# ── Payments ── mock (no real money) | razorpay (LIVE)
PAYMENTS_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxx
# RAZORPAY_ROUTE_ENABLED=true

# ── AI inference (cost engine) ──
BHASHINI_ENABLED=false
# BHASHINI_API_KEY=xxxxx
# GPU_INFERENCE_URL=http://gpu-host:8000
# LLM_API_KEY=xxxxx
API_MONTHLY_CAP_PAISE=3000000

# ── Auth ── none (demo) | jwt (production)
AUTH_MODE=none
# JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24

# ── Founder-in-the-loop gates (paise) — no-code tunable ──
HITL_FINANCE_GATE_PAISE=20000000
HITL_ONBOARDING_GATE_PAISE=5000000
HITL_LOGISTICS_GATE_PAISE=10000000
HITL_TWO_PERSON_GATE_PAISE=5000000

# ── Cost engine ──
COST_REVENUE_FLOOR_PAISE=10000000
COST_PHASE0_CARVEOUT_PAISE=20000000
COST_CEILING_PCT=0.02

# ───────────────────────────────────────────────────────────────
# PRODUCTION — fill these when ready. Leave commented = safe mock mode.
# (These mirror the cockpit "Go-Live Control" panel.)
# ───────────────────────────────────────────────────────────────
# NODE_ENV=production
# DATABASE_URL=postgres://user:pass@host:5432/nexus
# STORE_DRIVER=postgres
# PAYMENTS_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_ROUTE_ENABLED=true
# ANTHROPIC_API_KEY=
# BHASHINI_ENABLED=true
# BHASHINI_API_KEY=
# GOOGLE_MAPS_API_KEY=
# AUTH_SECRET=
# FOUNDER_TOKEN=
# COFOUNDER_TOKEN=
# JWT_SECRET=
# COMPLIANCE_CONFIRMED=true     # set LAST — only after lawyer + CA sign-off

# Optional: forward runtime errors to an external monitor (Sentry/Better Stack webhook)
MONITOR_WEBHOOK_URL=

# Notifications (WhatsApp/SMS + email) — provider-agnostic
MSG_PROVIDER=gupshup
MSG_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
