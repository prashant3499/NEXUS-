{
  "name": "nexus-desktop",
  "productName": "NEXUS",
  "version": "3.0.0",
  "description": "NEXUS — the trust & compliance engine for India's craft economy. Founder operating console.",
  "main": "main.js",
  "author": "NEXUS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexus.craft",
    "productName": "NEXUS",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload.js", "splash.html", "stopped.html", "build/icon.png", "package.json"],
    "extraResources": [
      { "from": "backend", "to": "backend", "filter": ["**/*", "!node_modules/**", "!data/**", "!**/*.log", "!.env"] }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS"
    },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "icon": "build/icon.png", "category": "Office" }
  }
}
